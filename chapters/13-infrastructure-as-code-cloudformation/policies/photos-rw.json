{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PhotosReadWrite",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::BUCKET/photos/*"
    },
    {
      "Sid": "ListOnlyPhotos",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::BUCKET",
      "Condition": { "StringLike": { "s3:prefix": "photos/*" } }
    }
  ]
}
