{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowBudgetsToPublish",
      "Effect": "Allow",
      "Principal": { "Service": "budgets.amazonaws.com" },
      "Action": "SNS:Publish",
      "Resource": "TOPIC_ARN",
      "Condition": {
        "StringEquals": { "aws:SourceAccount": "ACCOUNT_ID" },
        "ArnLike": { "aws:SourceArn": "arn:aws:budgets::ACCOUNT_ID:*" }
      }
    }
  ]
}
